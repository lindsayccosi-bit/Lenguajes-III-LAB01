package ejercicio2;

import java.util.Scanner;

public class arregloUnidimensional {
	public static void main (String[] args) {
		Scanner sc = new Scanner(System.in);
		//Se declara arreglo de 10 enteros donde se guardaran de manera creciente
		int[] arr = new int[10]; 
		
		System.out.println("Ingrese 10 números, cada uno debe ser mayor al anterior: ");
		for (int i = 0; i<10; i++) {
			int num; //Se declara variable temporal para el número a validar 
			do {
				System.out.print("Número " + (i+1) + ": ");
				num = sc.nextInt();
				// Si no es el primer número, se verifica que sea mayor que el anterior.
				if (i>0 && num <= arr[i-1]) { 
					System.out.println("El número debe ser mayor que el anterior ( " + arr[i-1] + "). Intente otra vez.");
				}
			} while (i>0 && num <= arr[i-1]); //Se repite mientras el número no sea mayor al anterior
			arr[i] = num; //Si pasa la validación se guarda el número en la posición correspondiente
		}
		System.out.print("Números guardados: ");
		for (int n : arr) {
			System.out.print(n + " ");
		}
	}

}
