using namespace std;
#include <iostream>

int SumarElementos(int arreglo[], int tam)
{
    int suma = 0;
    for (int i=0; i<tam;i++ ){
        suma += arreglo[i];
    }
    return suma;
}


int main()
{
    int numeros[] = {3,5,6,3};
    int tam = sizeof(numeros) / sizeof(numeros[0]);
    
    int resultado = SumarElementos(numeros, tam);
    cout << "La suma de los elementos es: " << resultado;

    return 0;
}



