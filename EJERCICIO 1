def leer_arreglo(n):
    arreglo = []
    print("Introduce los elementos del arreglo:")
    for i in range(n):
        num = int(input())
        arreglo.append(num)
    return arreglo

def sumar_numeros(arreglo):
    suma = 0
    for num in arreglo:
        suma += num
    return suma

# Programa principal sin main()
